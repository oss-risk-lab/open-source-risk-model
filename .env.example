# PostgreSQL (via Docker — run: docker compose up -d)
POSTGRES_DB=deepsignal
POSTGRES_USER=deepsignal
POSTGRES_PASSWORD=deepsignal
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://deepsignal:deepsignal@localhost:5432/deepsignal

# GitHub API Token (required for all operations)
# Create a personal access token at: https://github.com/settings/tokens
# Required scopes: public_repo (for public repositories)
GITHUB_TOKEN=your_github_token_here

# LLM Provider Configuration (optional)
# Required for: Natural language query classification and AI-powered features
# The abstraction layer supports multiple providers (currently OpenAI)

# LLM provider type (default: openai)
# LLM_PROVIDER=openai

# OpenAI API Key
# Get your API key at: https://platform.openai.com/api-keys
# If not set, you can still use dev mode by providing explicit intent + parameters
# OPENAI_API_KEY=sk-...

# OpenAI Base URL (optional - for custom endpoints or proxies)
# OPENAI_BASE_URL=https://api.openai.com/v1

# OpenAI Organization ID (optional - for organization-specific usage)
# OPENAI_ORGANIZATION=org-your-org-id

# Graph Configuration (optional)
# Controls graph generation behavior and limits

# Include CVE nodes in graph (may be slow due to external API calls)
# GRAPH_INCLUDE_CVES=true

# Maximum number of release nodes to include in graph
# GRAPH_MAX_RELEASES=10

# Maximum number of maintainer nodes to include in graph
# GRAPH_MAX_MAINTAINERS=5

# Maximum number of risk factor nodes to include in graph
# GRAPH_MAX_RISK_FACTORS=5

# Timeout for CVE API requests in seconds
# GRAPH_CVE_TIMEOUT_SECONDS=5

# Cache time-to-live in hours for graph data
# GRAPH_CACHE_TTL_HOURS=24

# Multi-Repo Persistent Graph Configuration (optional)
# Controls database persistence and batch ingestion behavior

# Path to SQLite database file for persistent graph storage
# GRAPH_DB_PATH=data/graphs.db

# Enable/disable persistence layer (if false, falls back to dynamic generation only)
# GRAPH_DB_ENABLED=true

# Cache TTL in hours for stored graph data
# GRAPH_TTL_HOURS=24

# Auto-regenerate stale data when TTL exceeded (if false, returns with is_stale flag)
# GRAPH_AUTO_REFRESH_STALE=false

# Background worker configuration
# Seconds between job queue polls
# GRAPH_WORKER_POLL_INTERVAL=5

# Enable/disable background ingestion worker
# GRAPH_WORKER_ENABLED=true
